# vim: ft=gitconfig
# Git settings shared by Linux and Windows.
# Linux: included from nix/modules/git/default.nix (copied into the Nix store).
# Windows: embedded into ~/.config/git/config by windows/dot_config/git/config.tmpl.
# OS-specific settings such as the credential helper do not belong here.

[user]
	name = "noize"
	email = "22848261+afxnoize@users.noreply.github.com"

[github]
	user = "afxnoize"

[alias]
	graph = "log --graph --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cn %Cred%d %Creset%s'"
	gr = "graph"
	b = "branch"
	br = "branch"
	s = "status"
	a = "add"
	ad = "add"
	cm = "commit"
	sw = "switch"
	d = "diff"
	df = "diff"
	# staged diff
	ds = "diff --cached"
	cp = "cherry-pick"
	st = "stash push -m"
	sta = "stash apply"
	stp = "stash pop"
	stl = "stash list"
	ft = "fetch"
	ftp = "fetch -p"
	ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"

[core]
	editor = "nvim"
	whitespace = "cr-at-eol"
	autocrlf = "input"
	quotePath = false

[gpg]
	program = "gpg"

[commit]
	gpgsign = false

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[diff]
	tool = "nvimdiff"

[difftool]
	prompt = false

[difftool "nvimdiff"]
	cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""

[merge]
	tool = "nvimdiff"

[mergetool]
	prompt = false
	keepBackup = false

[mergetool "diffview"]
	cmd = "nvim -n -c \"DiffviewOpen\" \"$MERGE\""

[mergetool "nvimdiff"]
	layout = "LOCAL,BASE,REMOTE / MERGED"

[init]
	defaultBranch = "main"

[ghq]
	root = "~/repos"

[wt]
	basedir = ".wt"
	nocd = false
