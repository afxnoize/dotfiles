[Unit]
Description=Update claude-code flake input and switch home-manager

[Service]
Type=oneshot
# nix/flake.nix reads USER and HOME via builtins.getEnv (--impure), and the
# user manager PATH has neither nix nor the home-manager profile.
Environment=USER=%u HOME=%h
Environment=PATH=%h/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/claude-update
TimeoutStartSec=1h
