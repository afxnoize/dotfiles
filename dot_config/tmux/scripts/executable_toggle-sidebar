#!/usr/bin/env bash
# Toggle sidebar: swap between agent-sidebar and yazi in the same pane slot
# Usage: toggle-sidebar [agent|yazi]

mode="${1:-agent}"
window_id=$(tmux display-message -p '#{window_id}')
current_path=$(tmux display-message -p '#{pane_current_path}')
git_root=$(git -C "$current_path" rev-parse --show-toplevel 2>/dev/null)

find_pane() {
    tmux list-panes -t "$window_id" -F '#{pane_id} #{@pane_role}' 2>/dev/null | \
        awk -v role="$1" '$2 == role {print $1}'
}

agent_pane=$(find_pane "sidebar")
yazi_pane=$(find_pane "yazi")

case "$mode" in
    agent)
        [ -n "$yazi_pane" ] && tmux kill-pane -t "$yazi_pane"
        bin=$(tmux display-message -p '#{@agent_sidebar_bin}')
        "$bin" toggle "$window_id" "$current_path"
        ;;
    yazi)
        [ -n "$agent_pane" ] && tmux kill-pane -t "$agent_pane"
        if [ -n "$yazi_pane" ]; then
            tmux kill-pane -t "$yazi_pane"
        else
            width=$(tmux show-options -gv @sidebar_width 2>/dev/null)
            leftmost_pane=$(tmux list-panes -t "$window_id" -F '#{pane_left} #{pane_id}' 2>/dev/null | \
                sort -n | head -n1 | awk '{print $2}')
            tmux split-window -t "${leftmost_pane:-$window_id}" -hfb -l "${width:-15%}" -c "${git_root:-$current_path}" \
                "tmux set -p @pane_role yazi; YAZI_CONFIG_HOME='${XDG_CONFIG_HOME:-$HOME/.config}/yazi-sidebar' YAZI_SIDEBAR=1 yazi"
        fi
        ;;
esac
