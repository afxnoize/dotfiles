#!/usr/bin/env bash
# Restore agent-sidebar pane after tmux-resurrect session restore.
# Called via @resurrect-processes "~tmux-agent-sidebar->..." directive.
#
# On restore, the sidebar pane falls back to $SHELL because resurrect
# cannot re-launch the TUI binary.  This script:
#   1. Deduplicates — kills any sidebar auto-created by after-new-window hook
#   2. Re-tags this pane with @pane_role=sidebar
#   3. Execs the sidebar TUI binary

set -euo pipefail

bin="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/plugins/tmux-agent-sidebar/bin/tmux-agent-sidebar"

if [[ ! -x "$bin" ]]; then
  echo "agent-sidebar binary not found: $bin"
  exec "${SHELL:-/bin/zsh}"
fi

window_id=$(tmux display-message -p '#{window_id}')
my_pane=$(tmux display-message -p '#{pane_id}')

# Kill any duplicate sidebar created by the after-new-window auto-create hook
# (fires during resurrect window recreation before processes are restored).
while IFS=' ' read -r pane_id role; do
  if [[ "$role" == "sidebar" && "$pane_id" != "$my_pane" ]]; then
    tmux kill-pane -t "$pane_id" 2>/dev/null || true
  fi
done < <(tmux list-panes -t "$window_id" -F '#{pane_id} #{@pane_role}' 2>/dev/null)

tmux set-option -p @pane_role sidebar
exec "$bin"
