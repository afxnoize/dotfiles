{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": true,
    "CLAUDE_CODE_FORK_SUBAGENT": true,
    "CLAUDE_CODE_HIDE_CWD": true
  },
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh release delete*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf /*)",
      "Bash(sudo rm -rf /)",
      "Bash(dd if=/dev/zero of=/dev/*)",
      "Bash(dd if=/dev/random of=/dev/*)",
      "Bash(mkfs*)",
      "Bash(fdisk*)",
      "Bash(parted*)",
      "Bash(*fork*bomb*)",
      "Bash(> /dev/sda*)",
      "Bash(> /dev/nvme*)",
      "Bash(> /dev/sd*)",
      "Bash(cat /dev/urandom > *)",
      "Bash(* | nc -l*)",
      "Bash(* | netcat -l*)",
      "Bash(* | socat *)",
      "Bash(* | base64 -d | sh*)",
      "Bash(* | base64 -d | bash*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_CONFIG_DIR/hooks/validate-bash.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_CONFIG_DIR/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "bun $CLAUDE_CONFIG_DIR/hooks/validate-cloud.ts aws",
            "if": "Bash(aws *)"
          },
          {
            "type": "command",
            "command": "bun $CLAUDE_CONFIG_DIR/hooks/validate-cloud.ts b2",
            "if": "Bash(b2 *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $XDG_DATA_HOME/tmux/plugins/tmux-agent-sidebar/hook.sh claude activity-log"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $XDG_DATA_HOME/tmux/plugins/tmux-agent-sidebar/hook.sh claude stop-failure"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $XDG_DATA_HOME/tmux/plugins/tmux-agent-sidebar/hook.sh claude user-prompt-submit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $XDG_DATA_HOME/tmux/plugins/tmux-agent-sidebar/hook.sh claude session-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash $XDG_DATA_HOME/tmux/plugins/tmux-agent-sidebar/hook.sh claude session-end"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "command": "bash /home/noize/.local/share/tmux/plugins/tmux-agent-sidebar/hook.sh claude cwd-changed",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "command": "bash /home/noize/.local/share/tmux/plugins/tmux-agent-sidebar/hook.sh claude permission-denied",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "bash /home/noize/.local/share/tmux/plugins/tmux-agent-sidebar/hook.sh claude subagent-start",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "bash /home/noize/.local/share/tmux/plugins/tmux-agent-sidebar/hook.sh claude subagent-stop",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "bash /home/noize/.local/share/tmux/plugins/tmux-agent-sidebar/hook.sh claude task-completed",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "command": "bash /home/noize/.local/share/tmux/plugins/tmux-agent-sidebar/hook.sh claude task-created",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "command": "bash /home/noize/.local/share/tmux/plugins/tmux-agent-sidebar/hook.sh claude teammate-idle",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "bash /home/noize/.local/share/tmux/plugins/tmux-agent-sidebar/hook.sh claude worktree-create",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "bash /home/noize/.local/share/tmux/plugins/tmux-agent-sidebar/hook.sh claude worktree-remove",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bun ~/.config/claude/statusline.js",
    "padding": 0
  },
  "enabledPlugins": {
    "moonbit-practice@moonbit-practice": true,
    "telegram@claude-plugins-official": false,
    "voltagent-research@voltagent-subagents": true
  },
  "extraKnownMarketplaces": {
    "anthropics-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "agent-plugins-for-aws": {
      "source": {
        "source": "github",
        "repo": "awslabs/agent-plugins"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "voltagent-subagents": {
      "source": {
        "source": "git",
        "url": "https://github.com/VoltAgent/awesome-claude-code-subagents.git"
      }
    }
  },
  "language": "japanese",
  "cleanupPeriodDays": 30,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": false
}
