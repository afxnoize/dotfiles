# Locale {{{
unset LC_ALL &> /dev/null
export LANG="${LANG:-ja_JP.UTF-8}"
# Defined by POSIX
unset LC_COLLATE &> /dev/null
export LC_TIME="${LC_TIME:-C.UTF-8}"
export LC_CTYPE="${LC_CTYPE:-ja_JP.UTF-8}"
export LC_MESSAGE="${LC_MESSAGE:-C.UTF-8}"
export LC_MONETARY="${LC_MONETARY:-C.UTF-8}"
export LC_NUMERIC="${LC_NUMERIC:-C.UTF-8}"
# GNU C library supports the following nonstandard categories
unset LC_PAPER &> /dev/null
unset LC_NAME &> /dev/null
unset LC_ADDRESS &> /dev/null
unset LC_TELEPHONE &> /dev/null
unset LC_MEASUREMENT &> /dev/null
unset LC_IDENTIFICATION &> /dev/null
# End of Locale }}}

# XDG Base Directory {{{
# Export the following environment variable in */etc/zsh/zshenv*
#   export ZDOTDIR="$HOME"/.config/zsh
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"
# End of XDG Base Directory }}}

# Zsh Base Directory {{{
export ZDOTDIR="${ZDOTDIR:-$HOME/.config/zsh}"
export ZHOMEDIR="${ZDOTDIR:-$HOME/.config/zsh}"
export ZSTATEDIR="$XDG_STATE_HOME/zsh"
export ZDATADIR="$XDG_DATA_HOME/zsh"
export ZCACHEDIR="$XDG_CACHE_HOME/zsh"

export ZRCDIR="$ZHOMEDIR/rc"
# End of Zsh Base Directory }}}

# AI Agents {{{
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$XDG_CONFIG_HOME/claude}"
export CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=0
export CODEX_HOME="${CODEX_HOME:-$XDG_CONFIG_HOME/codex}"
# End of AI Agents }}}

# Programing Langs {{{
# Golang {{{2
export GOPATH="${GOPATH:-$XDG_DATA_HOME/go}"
# End of Golang 2}}}

# Rust {{{2
export CARGO_HOME="${CARGO_HOME:-$XDG_DATA_HOME/cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-$XDG_DATA_HOME/rustup}"
# End of Rust 2}}}
# End of Programing Langs }}}

# FCITX {{{
export FCITX_CONFIG_DIR="${FCITX_CONFIG_DIR:-$XDG_CONFIG_HOME/fcitx}"
# }}}

# Local bin dir {{{
export LOCAL_BIN_DIR="$XDG_BIN_HOME"
# End of Local bin dir }}}

# Misc {{{
export EDITOR=/usr/bin/nvim
export SERENA_HOME="$XDG_CONFIG_HOME/serena"
export OCI_CLI_CONFIG_FILE="$XDG_CONFIG_HOME/oci/config"
export OCI_CLI_KEY_FILE="$XDG_CONFIG_HOME/oci/oci_api_key.pem"
# End of Misc }}}

# Paths {{{
path=(
	$GOPATH/bin(N-/)
	$LOCAL_BIN_DIR(N-/)
	$XDG_DATA_HOME/mise/shims(N-/)
	$path
)
export PATH
# deduplicate
typeset -U PATH

fpath=(
	$ZHOMEDIR/functions(N-/)
	$ZHOMEDIR/completions.local(N-/)
	$ZHOMEDIR/completions(N-/)
	$fpath
)
export FPATH
# deduplicate
typeset -U FPATH
# End of Paths }}}

# Local {{{
source "$ZDOTDIR/.zshenv.local"(N) 2>/dev/null
# }}}
