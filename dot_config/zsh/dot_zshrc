# chezmoi fzf completion (Tab triggers fzf for chezmoi edit/add)
_fzf_complete_chezmoi() {
	local subcmd="${words[2]}"
	if [[ ("$subcmd" == "edit" || "$subcmd" == "add") && ${#words[@]} -eq 2 ]]; then
		local target=$(chezmoi managed --include=files | fzf-tmux -p 80% --preview "bat --color=always --style=header,grid --line-range :80 $HOME/{}")
		if [ -n "$target" ]; then
			compadd -P '~/' -U -f -Q -- "$target"
		fi
	else
		_chezmoi "$@"
	fi
}
compdef _fzf_complete_chezmoi chezmoi

