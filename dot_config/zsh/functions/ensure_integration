local cmd=$1 version_cmd=$2 gen_cmd=$3
local hook_dir="$ZCACHEDIR/hooks"
local ver_dir="$hook_dir/.versions"
local hook_file="$hook_dir/${cmd}.zsh"
local ver_file="$ver_dir/${cmd}"

(( ${+commands[$cmd]} )) || return

local current_ver
current_ver=$(eval "$version_cmd" 2>/dev/null) || return

if [[ ! -r "$hook_file" ]] || [[ ! -r "$ver_file" ]] || [[ "$(< "$ver_file")" != "$current_ver" ]]; then
	mkdir -p "$hook_dir" "$ver_dir"
	eval "$gen_cmd" > "$hook_file" 2>/dev/null && echo "$current_ver" > "$ver_file"
	zcompile -R -- "$hook_file" 2>/dev/null
fi

source "$hook_file"
