local ghq_root=$(ghq root)
local src=$( (cd "$ghq_root" && command ls -td $(ghq list)) | fzf-tmux -p 80% --preview "bat --style=header,grid --line-range :80 $ghq_root/{}/README.*")
if [ -n "$src" ]; then
	if [ -n "$TMUX" ] && [ "$(tmux display -p '#{session_windows}')" -eq 1 ]; then
		tmux rename-session "${src##*/}" 2>/dev/null
	fi
	BUFFER="cd $ghq_root/$src"
	zle accept-line
fi
zle -R -c
