local sandboxed=0
[[ -n "$IN_CAGE" ]] && sandboxed=1

if (( ! sandboxed )) && [[ " $* " == *" --dangerously-skip-permissions "* ]]; then
	print -P "%F{yellow}⚠ sandbox なしで --dangerously-skip-permissions が有効です%f"
	print -P "%F{yellow}  cage claude --dangerously-skip-permissions を推奨%f"
	read -q "?続行しますか? [y/N] " || { echo; return 1; }
	echo
fi
command claude "$@"
