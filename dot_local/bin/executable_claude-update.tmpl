#!/bin/bash
# Update the claude-code flake input, then switch home-manager (hmu claude-code + hms).
# Run by claude-update.service (systemd user timer), i.e. outside the cage sandbox.
set -euo pipefail

repo="{{ .chezmoi.sourceDir }}"
flake="$repo/nix"

log() { printf 'claude-update: %s\n' "$*"; }

# The switch applies the whole working tree of nix/, so never run it unattended
# while nix/ has uncommitted edits other than flake.lock (work in progress).
# git runs on its own line so that a git failure aborts the script instead of
# looking like a clean tree.
status=$(git -C "$repo" status --porcelain -- nix)
dirty=$(grep -v ' nix/flake\.lock$' <<<"$status" || true)
if [[ -n "$dirty" ]]; then
  log "skip: uncommitted changes in nix/"
  printf '%s\n' "$dirty"
  exit 0
fi

rev() { jq -r '.nodes["claude-code"].locked.rev' "$flake/flake.lock"; }
before=$(rev)

out=$(nix flake update claude-code --flake "$flake" 2>&1) || {
  printf '%s\n' "$out"
  log "flake update failed"
  exit 1
}
[[ -z "$out" ]] || printf '%s\n' "$out"

# Without a GitHub token, an exhausted API rate limit makes nix fall back to the
# cached lock with only a warning, which would look like a successful no-op.
if grep -q 'using cached version' <<<"$out"; then
  log "flake update fell back to the cached lock (GitHub API rate limit?)"
  exit 1
fi

after=$(rev)
if [[ "$before" == "$after" ]]; then
  log "claude-code is already at ${after:0:7}"
else
  log "claude-code ${before:0:7} -> ${after:0:7}"
fi

# Always switch, even when the lock did not change, so a switch that failed
# on a previous run is retried instead of being skipped forever.
nh home switch --no-nom "$flake" -c "$USER" -- --impure
