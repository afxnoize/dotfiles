{{- /* Asked once at `chezmoi init`; answer is kept in the generated config. */ -}}
{{- $personal := promptBoolOnce . "personal" "Personal machine (deploy AutoHotkey scripts; requires configuration.personal.dsc.yaml)" -}}
# windows/ is the source root on Windows; persist it so later commands find it.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
personal = {{ $personal }}

# chezmoi runs .ps1 scripts with Windows PowerShell 5.1, whose default execution
# policy (Restricted) refuses to load them. Bypass it for the script process only.
[interpreters.ps1]
command = "powershell"
args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
